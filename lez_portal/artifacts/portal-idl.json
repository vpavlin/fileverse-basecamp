{
  "version": "2",
  "name": "portal",
  "messages": [
    {
      "name": "CreatePortal",
      "tag": 0,
      "docs": "Create a portal owned by the receiving actor's account.\n\nSent to the caller's own actor, which must be authorized. The portal lands at\n`Addresses::portal(owner, i)` where `i` is the owner head's current count, and is\nlisted in the registry and under its owner.",
      "fields": [
        {
          "name": "owner_did",
          "type": "string"
        },
        {
          "name": "metadata_cid",
          "type": "string"
        }
      ]
    },
    {
      "name": "Act",
      "tag": 1,
      "docs": "Do `op` on `portal` as the receiving actor's account.\n\nSent to the caller's own actor (the account of the owner or collaborator), which\nmust be authorized. The portal checks the caller against its owner and collaborators.",
      "fields": [
        {
          "name": "portal",
          "type": "account_id"
        },
        {
          "name": "op",
          "type": {
            "defined": "PortalOp"
          }
        }
      ]
    }
  ],
  "state_types": [
    "PortalState"
  ],
